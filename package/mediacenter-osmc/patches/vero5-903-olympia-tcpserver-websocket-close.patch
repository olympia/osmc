From 96501b88f67712262154c2d5f90bab66cb0d72f2 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 18 Oct 2026 11:00:41 +0200
Subject: [PATCH] [network] TCPServer: fix WebSocket close frame and leaked
 sockets

CWebSocketClient::Disconnect() sent the close frame through Send(),
which wraps all data in a text frame, so peers got a text frame with
the close frame bytes as payload (81 04 88 02 03 e8) and failed the
connection with an invalid UTF-8 error. Send it with CTCPClient::Send()
like PushBuffer() does for frames that are already framed.

It also closed the socket only once the close handshake was done, so a
peer that went away without a close frame left the descriptor open
after the connection was deleted. Close it in any case. PushBuffer()
calls Disconnect() itself when the client buffer overflows, so
Closing() now also reports a closed socket, and the server removes
that client before it would pass the invalid socket to select().
Master does both since #29636.

Backported to Kodi 21.3-Omega (a3a448d) for the OSMC vero5 build from
xbmc/xbmc#29959.
---
 xbmc/network/TCPServer.cpp | 8 +++++---
 xbmc/network/TCPServer.h   | 6 +++++-
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/xbmc/network/TCPServer.cpp b/xbmc/network/TCPServer.cpp
index 75334245..f1c05287 100644
--- a/xbmc/network/TCPServer.cpp
+++ b/xbmc/network/TCPServer.cpp
@@ -746,12 +746,14 @@ void CTCPServer::CWebSocketClient::Disconnect()
   {
     if (m_websocket->GetState() != WebSocketStateClosed && m_websocket->GetState() != WebSocketStateNotConnected)
     {
+      // Already framed, so it bypasses Send(), which would wrap it in a text frame
       const CWebSocketFrame *closeFrame = m_websocket->Close();
       if (closeFrame)
-        Send(closeFrame->GetFrameData(), (unsigned int)closeFrame->GetFrameLength());
+        CTCPClient::Send(closeFrame->GetFrameData(), (unsigned int)closeFrame->GetFrameLength());
     }
 
-    if (m_websocket->GetState() == WebSocketStateClosed)
-      CTCPClient::Disconnect();
+    // The caller drops this connection, so the descriptor goes with it even when the peer
+    // never answers the close frame
+    CTCPClient::Disconnect();
   }
 }
diff --git a/xbmc/network/TCPServer.h b/xbmc/network/TCPServer.h
index cf981941..23be8dd4 100644
--- a/xbmc/network/TCPServer.h
+++ b/xbmc/network/TCPServer.h
@@ -100,7 +100,11 @@ namespace JSONRPC
       void Disconnect() override;
 
       bool IsNew() const override { return m_websocket == NULL; }
-      bool Closing() const override { return m_websocket != NULL && m_websocket->GetState() == WebSocketStateClosed; }
+      bool Closing() const override
+      {
+        return m_socket == INVALID_SOCKET ||
+               (m_websocket != NULL && m_websocket->GetState() == WebSocketStateClosed);
+      }
 
     private:
       CWebSocket *m_websocket;

diff --git a/xbmc/guilib/TextureEdgeDiagnostics.cpp b/xbmc/guilib/TextureEdgeDiagnostics.cpp
--- /dev/null
+++ b/xbmc/guilib/TextureEdgeDiagnostics.cpp
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "TextureEdgeDiagnostics.h"
+
+#include "Texture.h"
+#include "filesystem/SpecialProtocol.h"
+#include "utils/log.h"
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace
+{
+constexpr uint64_t MAX_BYTES = 128ULL * 1024 * 1024;
+constexpr uint64_t MAX_LOADS = 20;
+constexpr unsigned int MAX_EVENTS = 2000;
+
+int64_t Now()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+struct State
+{
+  State()
+  {
+    const std::string temp = CSpecialProtocol::TranslatePath("special://temp/");
+    std::ifstream config(temp + "texture-edge-diagnostics.conf");
+    if (!std::getline(config, target))
+      return;
+    if (!target.empty() && target.back() == '\r')
+      target.pop_back();
+    // Exact local pathname only; never match every image or remote credentials.
+    if (target.empty() || target.front() != '/')
+    {
+      target.clear();
+      return;
+    }
+    std::string pattern = temp + "texture-edge-diag-XXXXXX";
+    std::vector<char> name(pattern.begin(), pattern.end());
+    name.push_back('\0');
+    const char* created = ::mkdtemp(name.data());
+    if (!created)
+    {
+      target.clear();
+      CLog::Log(LOGWARNING, "TextureEdgeDiag v1: cannot create output directory");
+      return;
+    }
+    directory = created;
+    events.open(directory + "/events.tsv", std::ios::out);
+    std::ofstream source(directory + "/source.txt");
+    source << target << '\n';
+    if (!events || !source)
+    {
+      target.clear();
+      CLog::Log(LOGWARNING, "TextureEdgeDiag v1: cannot open output files");
+      return;
+    }
+    events << "epoch_ms\tid\tevent\n";
+    CLog::Log(LOGINFO, "TextureEdgeDiag v1: enabled; output {}", directory);
+  }
+
+  std::mutex mutex;
+  std::string target;
+  std::string directory;
+  std::ofstream events;
+  uint64_t loads{0};
+  uint64_t bytes{0};
+  unsigned int count{0};
+  std::map<std::pair<uint64_t, uintptr_t>, std::chrono::steady_clock::time_point> lastDraw;
+  bool trackerLimitReported{false};
+  std::array<unsigned int, MAX_LOADS + 1> dumps{};
+
+  void Log(uint64_t id, const std::string& text)
+  {
+    if (count < MAX_EVENTS)
+    {
+      ++count;
+      events << Now() << '\t' << id << '\t' << text << std::endl;
+    }
+    else if (count == MAX_EVENTS)
+    {
+      ++count;
+      events << Now() << "\t0\tevent_limit_reached further_events_omitted" << std::endl;
+    }
+  }
+};
+
+State& GetState()
+{
+  static State state;
+  return state;
+}
+}
+
+uint64_t TextureEdgeDiagnostics::Begin(const std::string& path)
+{
+  auto& state = GetState();
+  if (state.target.empty() || CSpecialProtocol::TranslatePath(path) != state.target)
+    return 0;
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.loads >= MAX_LOADS)
+    return 0;
+  const uint64_t id = ++state.loads;
+  state.Log(id, "begin");
+  CLog::Log(LOGINFO, "TextureEdgeDiag v1: load {}", id);
+  return id;
+}
+
+void TextureEdgeDiagnostics::Event(uint64_t id, const std::string& text, uintptr_t control)
+{
+  if (!id || id > MAX_LOADS)
+    return;
+  auto& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.count >= MAX_EVENTS)
+  {
+    state.Log(id, text); // Emit the one-time truncation marker, if needed.
+    return;
+  }
+  if (control)
+  {
+    const auto key = std::make_pair(id, control);
+    auto previous = state.lastDraw.find(key);
+    // Bound bookkeeping too, even if a skin repeatedly creates new controls.
+    if (previous == state.lastDraw.end() && state.lastDraw.size() >= 128)
+    {
+      if (!state.trackerLimitReported)
+      {
+        state.trackerLimitReported = true;
+        state.Log(id, "draw_tracker_limit_reached new_controls_omitted");
+      }
+      return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (previous != state.lastDraw.end() &&
+        now - previous->second < std::chrono::milliseconds(250))
+      return;
+    state.lastDraw[key] = now;
+  }
+  state.Log(id, text);
+}
+
+void TextureEdgeDiagnostics::Dump(uint64_t id, const CTexture& t,
+                                  const char* stage, const char* encoding)
+{
+  if (!id || id > MAX_LOADS)
+    return;
+  auto& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  // This diagnostic supports ordinary 32-bit poster images only.
+  const uint64_t size = uint64_t(t.GetPitch()) * t.GetRows();
+  if (!t.GetPixels() || !t.GetWidth() || !t.GetHeight() ||
+      t.GetWidth() > t.GetTextureWidth() || t.GetHeight() > t.GetTextureHeight() ||
+      uint64_t(t.GetPitch()) != uint64_t(t.GetTextureWidth()) * 4 ||
+      t.GetRows() != t.GetTextureHeight() || size > MAX_BYTES ||
+      state.bytes > MAX_BYTES - size || state.dumps[id] >= 3)
+  {
+    state.Log(id, std::string("dump_skipped ") + stage + " invalid_dimensions_or_budget");
+    return;
+  }
+  state.bytes += size; // Reserve even if I/O fails; never exceed the session budget.
+  ++state.dumps[id];
+  const std::string stem = state.directory + "/" + std::to_string(id) + "-" + stage;
+  std::ofstream raw(stem + ".raw", std::ios::binary);
+  raw.write(reinterpret_cast<const char*>(t.GetPixels()), static_cast<std::streamsize>(size));
+  raw.close();
+  // Check padding without modifying it. Before clamping, mismatches are expected.
+  uint64_t rightBad = 0;
+  uint64_t bottomBad = 0;
+  const auto* pixels = t.GetPixels();
+  for (unsigned int y = 0; y < t.GetHeight(); ++y)
+  {
+    const auto* row = pixels + size_t(y) * t.GetPitch();
+    for (unsigned int x = t.GetWidth(); x < t.GetTextureWidth(); ++x)
+      rightBad += std::memcmp(row + size_t(x) * 4, row + size_t(t.GetWidth() - 1) * 4, 4) != 0;
+  }
+  for (unsigned int y = t.GetHeight(); y < t.GetTextureHeight(); ++y)
+    bottomBad += std::memcmp(pixels + size_t(y) * t.GetPitch(),
+                            pixels + size_t(t.GetHeight() - 1) * t.GetPitch(), t.GetPitch()) != 0;
+  std::ofstream meta(stem + ".meta");
+  meta << "version=1\nid=" << id << "\nstage=" << stage << "\nepoch_ms=" << Now()
+       << "\nencoding=" << encoding << "\nwidth=" << t.GetWidth()
+       << "\nheight=" << t.GetHeight() << "\ntexture_width=" << t.GetTextureWidth()
+       << "\ntexture_height=" << t.GetTextureHeight() << "\npitch=" << t.GetPitch()
+       << "\nrows=" << t.GetRows() << "\nbytes=" << size
+       << "\noriginal_width=" << t.GetOriginalWidth()
+       << "\noriginal_height=" << t.GetOriginalHeight()
+       << "\norientation=" << t.GetOrientation() << "\nalpha=" << t.HasAlpha()
+       << "\nright_bad_pixels=" << rightBad << "\nbottom_bad_rows=" << bottomBad << '\n';
+  meta.close();
+  state.Log(id, std::string(raw && meta ? "dump " : "dump_io_error ") + stage);
+}

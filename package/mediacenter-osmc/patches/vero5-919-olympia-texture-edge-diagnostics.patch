+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+class CTexture;
+
+namespace TextureEdgeDiagnostics
+{
+// Configuration is read once, on first file load. No configuration means no output.
+uint64_t Begin(const std::string& path);
+void Dump(uint64_t id, const CTexture& texture, const char* stage, const char* encoding);
+void Event(uint64_t id, const std::string& text, uintptr_t control = 0);
+}

+// Whether there is art next to a movie or music video, or in the movie set information folder of
+// the set of a movie, that the scanner picks up only when it may use local information, following
+// CVideoInfoScanner::GetArtwork. It lists the folders and can cache a folder image to tell its
+// type, the same work the scan does again when it uses local information.
+bool HasLocalArt(const CFileItem& item, CONTENT_TYPE content, bool useFolderNames)
+{
+  if (content != CONTENT_MOVIES && content != CONTENT_MUSICVIDEOS)
+    return false;
+
+  const int artLevel{CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_VIDEOLIBRARY_ARTWORK_LEVEL)};
+  if (artLevel == CSettings::VIDEOLIBRARY_ARTWORK_LEVEL_NONE)
+    return false;
+
+  const bool addAll{artLevel == CSettings::VIDEOLIBRARY_ARTWORK_LEVEL_ALL};
+  const bool exactName{artLevel == CSettings::VIDEOLIBRARY_ARTWORK_LEVEL_BASIC};
+  std::vector<std::string> artTypes{CVideoThumbLoader::GetArtTypes(
+      content == CONTENT_MOVIES ? MediaTypeMovie : MediaTypeMusicVideo)};
+
+  // the art of the set of a movie is taken from next to the movie as well. The set comes from the
+  // new scrape, so the names are looked for whether or not the movie is in a set now
+  std::vector<std::string> setArtTypes;
+  if (content == CONTENT_MOVIES)
+  {
+    setArtTypes = CVideoThumbLoader::GetArtTypes(MediaTypeVideoCollection);
+    for (const std::string& artType : setArtTypes)
+      artTypes.push_back("set." + artType);
+  }
+
+  CGUIListItem::ArtMap art;
+  if (!item.SkipLocalArt())
+  {
+    const std::string filename{item.GetLocalArtBaseFilename()};
+    if (useFolderNames)
+    {
+      const std::string directory{URIUtils::GetDirectory(filename)};
+      if (filename != directory)
+        CVideoInfoScanner::AddLocalItemArtwork(art, artTypes, directory, addAll, exactName);
+    }
+    CVideoInfoScanner::AddLocalItemArtwork(art, artTypes, filename, addAll, exactName);
+  }
+
+  // the scanner reads the movie set information folder only with local information as well, which
+  // it never uses for a plugin. The set the movie is in now is taken, which the new scrape
+  // normally keeps
+  if (art.empty() && content == CONTENT_MOVIES && !item.IsPlugin() && item.HasVideoInfoTag())
+  {
+    const std::string setInfoPath{
+        CVideoInfoScanner::GetMovieSetInfoFolder(item.GetVideoInfoTag()->m_set.title)};
+    if (!setInfoPath.empty())
+      CVideoInfoScanner::AddLocalItemArtwork(art, setArtTypes, setInfoPath, addAll, exactName);
+  }
+
+  return !art.empty();
+}

From a858d1e2eaa8dc1c7d45299b9cd7661068c1bb2a Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sat, 7 Nov 2026 23:50:43 +0100
Subject: [PATCH] [GUIMediaWindow] Reload a library filter node through the
 node

[GUIMediaWindow] Reload a library filter node through the node (b44df4a)

A library filter node gives its items the db path it resolves to, so the
window path, the history and every later refresh use the videodb or
musicdb URL. Loading that URL directly skips the node, and the list
loses the node's label and sort order. After stopping playback started
from such a node, the list comes back labelled "titles" and sorted like
the main title list.

Remember the last loaded filter node together with its db path, and
fetch the items through the node whenever the window loads that db path.
The window path, the history and the parent item keep the db path. If
the node no longer loads, the db path is loaded as before. The pair is
dropped when the window is opened with a path of its own or reset.

[GUIMediaWindow] Keep the library filter node when its load fails (a858d1e)

A load through a library filter node that fails while the node file is
still there was cancelled from the busy dialog, or the node is hidden by
its visible condition. Return false in that case, as master does on a
cancel, and keep the remembered node. Loading the db path in its place
ran the same slow query again under a second dialog and dropped the node
for every later reload in the window.

Backported to Kodi 21.3-Omega (a3a448d) for the OSMC vero5 build from
xbmc/xbmc#30368 (a858d1e), its two commits squashed. Omega has no
ITEM::PROPERTY::LIBRARY_FILTER, so the "library.filter" string is used.
---
 xbmc/windows/GUIMediaWindow.cpp | 38 ++++++++++++++++++++++++++++++++++++--
 xbmc/windows/GUIMediaWindow.h   |  3 +++
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/xbmc/windows/GUIMediaWindow.cpp b/xbmc/windows/GUIMediaWindow.cpp
index 20dc626979..608b189749 100644
--- a/xbmc/windows/GUIMediaWindow.cpp
+++ b/xbmc/windows/GUIMediaWindow.cpp
@@ -31,6 +31,7 @@
 #include "dialogs/GUIDialogMediaFilter.h"
 #include "dialogs/GUIDialogProgress.h"
 #include "dialogs/GUIDialogSmartPlaylistEditor.h"
+#include "filesystem/Directory.h"
 #include "filesystem/FileDirectoryFactory.h"
 #include "filesystem/MultiPathDirectory.h"
 #include "filesystem/PluginDirectory.h"
@@ -331,6 +332,8 @@ bool CGUIMediaWindow::OnMessage(CGUIMessage& message)
       if (message.GetParam1() == GUI_MSG_WINDOW_RESET)
       {
         m_vecItems->SetPath("?");
+        m_libraryFilterNodePath.clear();
+        m_libraryFilterDbPath.clear();
         return true;
       }
       else if ( message.GetParam1() == GUI_MSG_REFRESH_THUMBS )
@@ -548,6 +551,8 @@ bool CGUIMediaWindow::OnMessage(CGUIMessage& message)
         }
         if (resetHistory)
         {
+          m_libraryFilterNodePath.clear();
+          m_libraryFilterDbPath.clear();
           m_vecItems->RemoveDiscCache(GetID());
           // only compute the history for the provided path if "return" is not defined
           // (otherwise the root level for the path will be added by default to the path history
@@ -750,11 +755,32 @@ bool CGUIMediaWindow::GetDirectory(const std::string &strDirectory, CFileItemLis
       SetupShares();
 
     CFileItemList dirItems;
-    if (!GetDirectoryItems(pathToUrl, dirItems, UseFileDirectories()))
+    CFileItemList nodeItems;
+    bool viaNode{false};
+    if (!m_libraryFilterDbPath.empty() && strDirectory == m_libraryFilterDbPath)
+    {
+      CURL nodeUrl{m_libraryFilterNodePath};
+      viaNode = GetDirectoryItems(nodeUrl, nodeItems, UseFileDirectories());
+      if (viaNode)
+      {
+        m_libraryFilterDbPath = nodeItems.GetPath();
+      }
+      else if (XFILE::CDirectory::Exists(m_libraryFilterNodePath, false))
+      {
+        // still there, so cancelled or hidden: don't load the db path in its place
+        return false;
+      }
+      else
+      {
+        m_libraryFilterNodePath.clear();
+        m_libraryFilterDbPath.clear();
+      }
+    }
+    if (!viaNode && !GetDirectoryItems(pathToUrl, dirItems, UseFileDirectories()))
       return false;
 
     // assign fetched directory items
-    items.Assign(dirItems);
+    items.Assign(viaNode ? nodeItems : dirItems);
 
     // took over a second, and not normally cached, so cache it
     auto end = std::chrono::steady_clock::now();
@@ -860,6 +886,14 @@ bool CGUIMediaWindow::Update(const std::string &strDirectory, bool updateFilterP
     return false;
   }
 
+  if (URIUtils::IsLibraryFolder(pathNoFilter) &&
+      m_vecItems->GetProperty("library.filter").asBoolean() &&
+      m_vecItems->GetPath() != pathNoFilter)
+  {
+    m_libraryFilterNodePath = pathNoFilter;
+    m_libraryFilterDbPath = m_vecItems->GetPath();
+  }
+
   if (m_vecItems->GetLabel().empty())
   {
     // Removable sources
diff --git a/xbmc/windows/GUIMediaWindow.h b/xbmc/windows/GUIMediaWindow.h
index 43609a13c1..e30b14ad5b 100644
--- a/xbmc/windows/GUIMediaWindow.h
+++ b/xbmc/windows/GUIMediaWindow.h
@@ -218,5 +218,8 @@ protected:
    \sa Update
    */
   std::string m_strFilterPath;
+  // Last library filter node and the db path of its items; that db path is loaded through the node
+  std::string m_libraryFilterNodePath;
+  std::string m_libraryFilterDbPath;
   bool m_backgroundLoad = false;
 };

From d66d409ff799bcbab61db5ee320a798a3161b36f Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 25 Oct 2026 19:00:02 +0100
Subject: [PATCH] [Video] Do not refresh the list when the Manage menu is
 cancelled

ManageVideoItem() returns the chosen button on success and -1 when the
dialog was dismissed or the action failed. The caller only compared the
result to CONTEXT_BUTTON_CANCELLED (0), so closing the Manage menu with
Back still did a full list refresh and dropped the directory cache.

Backported to Kodi 21.3-Omega (a3a448d) for the OSMC vero5 build from
xbmc/xbmc#30124 (657d93f).
---
 xbmc/video/windows/GUIWindowVideoNav.cpp | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/windows/GUIWindowVideoNav.cpp b/xbmc/video/windows/GUIWindowVideoNav.cpp
index bf48756f0..3fbcbbda2 100644
--- a/xbmc/video/windows/GUIWindowVideoNav.cpp
+++ b/xbmc/video/windows/GUIWindowVideoNav.cpp
@@ -882,10 +882,9 @@ bool CGUIWindowVideoNav::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
   {
   case CONTEXT_BUTTON_EDIT:
     {
-      const CONTEXT_BUTTON ret{
-          static_cast<CONTEXT_BUTTON>(CGUIDialogVideoInfo::ManageVideoItem(item))};
+      const int ret{CGUIDialogVideoInfo::ManageVideoItem(item)};
 
-      if (ret != CONTEXT_BUTTON_CANCELLED)
+      if (ret >= 0)
       {
         Refresh(true);
         if (ret == CONTEXT_BUTTON_DELETE)
